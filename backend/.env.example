SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-service-key
RIOT_API_KEY=your-riot-api-key
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=False

# Riot API レート制限（省略時は Personal キー向けの既定値）。Production キーは 450:10,27000:600
# RIOT_RATE_LIMITS=18:1,95:120
# RIOT_RATE_LIMIT_MAX_WAIT_SECONDS=10
# RIOT_BACKFILL_RESERVE_RATIO=0.3

# ユーザー制限（第2段階）。省略時は無効。Lambda では true にする
# USER_GATE_ENABLED=false
# ALLOWED_EMAILS=
# SUPABASE_JWT_SECRET=
# SUPABASE_PROJECT_REF=

# Backfill の起動方法。inline（既定）= 同じプロセス、lambda = 別の Lambda を非同期起動
# BACKFILL_MODE=inline
# BACKFILL_FUNCTION_NAME=

# 試合の生データの保存先。省略時は Supabase Storage、設定すると S3
# RAW_BUCKET=

# 設定を SSM Parameter Store から読む（Lambda 用。環境変数で指定する）
# SSM_PARAMETER_PATH=
