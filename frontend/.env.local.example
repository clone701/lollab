# Supabase設定
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Riot API設定
RIOT_API_KEY=""

# バックエンドAPI設定（ローカル開発のみ。本番は未設定＝同じオリジン）
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# ログイン必須のゲート（AuthGate）。ビルド時に決まる。'false' のときだけ無効、未設定は有効
# 一般公開時やゲート不要のローカル開発では false
# NEXT_PUBLIC_AUTH_GATE_ENABLED="false"
